# The bundled A7V mesh has no verified animation clips. The engine moves the
# entity on the map; the model itself stays static until clips are supplied.
entity = {
	name = "endsieg_ww1_german_a7v_entity"
	pdxmesh = "endsieg_ww1_german_a7v_mesh"
	default_state = "idle"
	state = { name = "idle" }
	state = { name = "move" }
	state = { name = "retreat" }
	state = { name = "attack" }
	state = { name = "defend" }
	state = { name = "support_attack" }
	state = { name = "training" }
	scale = 0.5
}
