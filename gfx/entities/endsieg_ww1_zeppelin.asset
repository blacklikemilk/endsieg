# Static native PDX airship model for the WWI air wing.
entity = {
	name = "endsieg_ww1_zeppelin_entity"
	pdxmesh = "endsieg_ww1_zeppelin_mesh"
	default_state = "idle"
	state = { name = "idle" }
	state = { name = "attack" }
	state = { name = "fire" }
	state = { name = "bomb" }
	state = { name = "firebomb" }
	state = { name = "crash" }
	state = { name = "explode" }
	scale = 0.16
}

# Equipment and sub-unit aliases use the same static model.  Separate aliases
# keep the engine's conventional generated equipment model IDs resolvable while
# allowing the two technology levels to remain visually consistent.
entity = { name = "endsieg_ww1_zeppelin_equipment_entity" clone = "endsieg_ww1_zeppelin_entity" }
entity = { name = "endsieg_ww1_zeppelin_equipment_1_entity" clone = "endsieg_ww1_zeppelin_entity" }
entity = { name = "endsieg_ww1_zeppelin_equipment_2_entity" clone = "endsieg_ww1_zeppelin_entity" }
entity = { name = "archetype_endsieg_ww1_zeppelin_equipment_entity" clone = "endsieg_ww1_zeppelin_entity" }
