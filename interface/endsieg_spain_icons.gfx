# Overview: sprite definitions for the Spanish campaign surfaces that have no vanilla equivalent.
# Both sides use vanilla balance-of-power art at the panel's native size: the king for the Crown,
# the chamber for the Cortes. Custom Spanish art is pending; the sprites point at art that exists.

spriteTypes = {
	spriteType = {
		name = "GFX_bop_SPR_crown_side"
		texturefile = "gfx/interface/bop/bop_ITA_king_side.dds"
	}
	spriteType = {
		name = "GFX_bop_SPR_cortes_side"
		texturefile = "gfx/interface/bop/bop_ITA_grand_council_side.dds"
	}
}
