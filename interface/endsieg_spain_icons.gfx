# Overview: sprite definitions for the Spanish campaign surfaces that have no vanilla equivalent.
# Both balance-of-power side icons reuse existing vanilla decision art, so no runtime reference is missing.
# Custom Spanish art for these two sides is listed as pending in docs/spain_campaign.md.

spriteTypes = {
	spriteType = {
		name = "GFX_bop_SPR_crown_side"
		texturefile = "gfx/interface/decisions/decision_category_generic_monarchism.dds"
	}
	spriteType = {
		name = "GFX_bop_SPR_cortes_side"
		texturefile = "gfx/interface/decisions/decision_category_generic_democracy.dds"
	}
}
