# Overview: sprite definitions for the Spanish campaign surfaces that have no vanilla equivalent.
# Both sides use vanilla balance-of-power art at the panel's native size: the king for the Crown,
# the chamber for the Cortes. Custom Spanish art is pending; the sprites point at art that exists.

spriteTypes = {
	spriteType = {
		name = "GFX_bop_SPR_crown_side"
		texturefile = "gfx/interface/bop/bop_ITA_king_side.dds"
	}
	spriteType = {
		name = "GFX_bop_SPR_cortes_side"
		texturefile = "gfx/interface/bop/bop_ITA_grand_council_side.dds"
	}


	# Cortes hemicycle seat dots, generated by tools/build_spain_cortes_dots.py.
	# The chamber reads the strip: eight 16px frames, frame 0 the neutral seat and frames 1..7
	# the parties in chamber order, so a dot only has to name the frame its seat variable holds.
	spriteType = {
		name = "GFX_spain_cortes_seats"
		texturefile = "gfx/interface/endsieg_spain_dots/spain_cortes_seats.dds"
		noOfFrames = 8
	}
	spriteType = {
		name = "GFX_spain_cortes_dot_socialists"
		texturefile = "gfx/interface/endsieg_spain_dots/spain_cortes_dot_socialists.dds"
	}
	spriteType = {
		name = "GFX_spain_cortes_dot_republicans"
		texturefile = "gfx/interface/endsieg_spain_dots/spain_cortes_dot_republicans.dds"
	}
	spriteType = {
		name = "GFX_spain_cortes_dot_liberals"
		texturefile = "gfx/interface/endsieg_spain_dots/spain_cortes_dot_liberals.dds"
	}
	spriteType = {
		name = "GFX_spain_cortes_dot_conservatives"
		texturefile = "gfx/interface/endsieg_spain_dots/spain_cortes_dot_conservatives.dds"
	}
	spriteType = {
		name = "GFX_spain_cortes_dot_monarchists"
		texturefile = "gfx/interface/endsieg_spain_dots/spain_cortes_dot_monarchists.dds"
	}
	spriteType = {
		name = "GFX_spain_cortes_dot_carlists"
		texturefile = "gfx/interface/endsieg_spain_dots/spain_cortes_dot_carlists.dds"
	}
	spriteType = {
		name = "GFX_spain_cortes_dot_falange"
		texturefile = "gfx/interface/endsieg_spain_dots/spain_cortes_dot_falange.dds"
	}
	spriteType = {
		name = "GFX_spain_cortes_dot_empty"
		texturefile = "gfx/interface/endsieg_spain_dots/spain_cortes_dot_empty.dds"
	}
}
