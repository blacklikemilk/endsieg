### Endsieg scenario selection screen.
#
# Sprites used by interface/frontendgamesetupview.gui on the bookmark (scenario)
# screen: the card frame, the screen background and one painting per scenario.
#
# The paintings and the frame are built by tools/build_scenario_art.py, which
# documents the sizes. Bookmark `picture = ` in common/bookmarks/ points at the
# GFX_select_date_* names below, so those names are load-bearing: keep the vanilla
# names for the two base-game scenarios (1936, 1939) that this mod still offers.
#
# card_frame.dds holds two stacked frames (normal, selected) and drives
# bookmark_entry's `background`, so noOfFrames = 2 is required.

spriteTypes = {

	spriteType = {
		name = "GFX_bookmark_entry_bg"
		texturefile = "gfx/interface/scenario_select/card_frame.dds"
		noOfFrames = 2
		effectFile = "gfx/FX/buttonstate_nodowneffect.lua"
	}

	spriteType = {
		name = "GFX_select_date_bg"
		texturefile = "gfx/interface/scenario_select/scenario_bg.dds"
		effectFile = "gfx/FX/buttonstate_nodowneffect.lua"
	}

	# --- scenario paintings -------------------------------------------------
	spriteType = {
		name = "GFX_select_date_1910"
		texturefile = "gfx/interface/scenario_select/card_1910.dds"
	}
	spriteType = {
		name = "GFX_select_date_1914"
		texturefile = "gfx/interface/scenario_select/card_1914.dds"
	}
	spriteType = {
		name = "GFX_select_date_1916"
		texturefile = "gfx/interface/scenario_select/card_1916.dds"
	}
	spriteType = {
		name = "GFX_select_date_1918"
		texturefile = "gfx/interface/scenario_select/card_1918.dds"
	}
	spriteType = {
		name = "GFX_select_date_1936"
		texturefile = "gfx/interface/scenario_select/card_1936.dds"
	}
	spriteType = {
		name = "GFX_select_date_1939"
		texturefile = "gfx/interface/scenario_select/card_1939.dds"
	}
	spriteType = {
		name = "GFX_select_date_1941"
		texturefile = "gfx/interface/scenario_select/card_1941.dds"
	}
	spriteType = {
		name = "GFX_select_date_1942"
		texturefile = "gfx/interface/scenario_select/card_1942.dds"
	}
	spriteType = {
		name = "GFX_select_date_1943"
		texturefile = "gfx/interface/scenario_select/card_1943.dds"
	}
	spriteType = {
		# Götterdämmerung, 21 June 1944 (Normandy).
		name = "GFX_select_date_1944"
		texturefile = "gfx/interface/scenario_select/card_1944_06.dds"
	}
	spriteType = {
		# Kampf um das Vaterland, 16 December 1944 (the Ardennes).
		name = "GFX_select_date_1945"
		texturefile = "gfx/interface/scenario_select/card_1944_12.dds"
	}
	spriteType = {
		# Endsieg, 20 March 1945 (Berlin).
		name = "GFX_select_date_1945_2"
		texturefile = "gfx/interface/scenario_select/card_1945_03.dds"
	}

	# --- kept for future bookmarks, still on the old paintings --------------
	spriteType = {
		name = "GFX_select_date_1933"
		texturefile = "gfx/interface/select_date_1933.dds"
	}
	spriteType = {
		name = "GFX_select_date_1950"
		texturefile = "gfx/interface/select_date_1950.dds"
	}
}
