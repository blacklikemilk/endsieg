guiTypes = {
	containerWindowType = {
		name = "endsieg_rations_topbar_container"
		# The vanilla XP gauges are at x=796, 854 and 912; the vanilla
		# nuclear stockpile occupies x=970..1026.  Start immediately after
		# that block so the ration gauge stays beside the XP cluster without
		# covering a vanilla top-bar control.
		position = { x = 1028 y = 4 }
		size = { width = 70 height = 28 }
		Orientation = UPPER_LEFT
		clipping = no

		iconType = {
			name = "endsieg_ration_value_bg"
			spriteType = "GFX_generic_box_smallest"
			position = { x = 0 y = 0 }
			Orientation = UPPER_LEFT
		}

		iconType = {
			name = "endsieg_ration_icon"
			spriteType = "GFX_tech_rations"
			position = { x = 2 y = 6 }
			scale = 0.22
			Orientation = UPPER_LEFT
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "endsieg_ration_value"
			position = { x = 20 y = 4 }
			font = "hoi_18mbs"
			text = "[?endsieg_ration_days|0]d"
			format = center
			maxWidth = 48
			maxHeight = 24
			fixedsize = yes
			pdx_tooltip = "ENDSIEG_RATIONS_TOPBAR_TOOLTIP"
			pdx_tooltip_delayed = "ENDSIEG_RATIONS_TOPBAR_TOOLTIP_DELAYED"
		}

		iconType = {
			name = "endsieg_ration_bar"
			spriteType = "GFX_topbar_fuel_bar"
			position = { x = 21 y = 20 }
			frame = 0
			alwaystransparent = yes
		}
	}
}
