guiTypes = {

	# The Cortes chamber panel. Mounted by common/scripted_guis/spain_cortes_scripted_gui.txt
	# from the SPR_cortes decision category, which draws it inside the category description.
	#
	# Generated by tools/build_spain_cortes_hemicycle.py: the hemicycle, the legend and the
	# summary are all generated, because the number of dots and the parties live there.
	containerWindowType = {
		name = "spain_cortes_window"
		position = { x = 0 y = 0 }
		size = { width = 500 height = 570 }
		Orientation = UPPER_LEFT
		clipping = no

		instantTextBoxType = {
			name = "spain_cortes_title"
			position = { x = 8 y = 4 }
			font = hoi_18b
			text = "SPAIN_CORTES_TITLE"
			maxWidth = 240
			maxHeight = 22
			fixedsize = yes
		}

		instantTextBoxType = {
			name = "spain_cortes_scale"
