guiTypes = {

	# The chamber panel. Mounted by common/scripted_guis/spain_cortes_scripted_gui.txt
	# from the SPR_cortes decision category.
	# Width is generous on purpose: bloc names are long and the seat column must never
	# overlap them, so each row is icon / name (420px) / seats (80px), right-aligned.
