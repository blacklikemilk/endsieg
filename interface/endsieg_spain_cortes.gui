guiTypes = {

	# The chamber panel. Mounted by common/scripted_guis/spain_cortes_scripted_gui.txt from the
	# SPR_cortes decision category, which draws it inside the category description.
	#
	# That description is about 500px wide, so the window is sized to it: anything wider has its
	# right-hand column clipped, which is how the seat figures were being lost.
	# Seven party rows on a 32px pitch: 24px icon at x=8, name at x=40, seats right-aligned at 396.
	containerWindowType = {
		name = "spain_cortes_window"
		position = { x = 0 y = 0 }
		size = { width = 500 height = 420 }
		Orientation = UPPER_LEFT
		clipping = no

		instantTextBoxType = {
			name = "spain_cortes_title"
			position = { x = 8 y = 6 }
			font = "hoi_18mbs"
			text = "SPAIN_CORTES_TITLE"
			maxWidth = 484
			maxHeight = 24
			fixedsize = yes
		}

