guiTypes = {

	# The chamber panel. Mounted by common/scripted_guis/spain_cortes_scripted_gui.txt
	# from the SPR_cortes decision category.
	#
	# Geometry is deliberately regular: every party row is 40px tall, so the seven blocs read
	# as one table. Icon 32px at x=26, name at x=72, seats right-aligned at x=690.
	# The two majority lines share a position and are separated by their scripted GUI
	# triggers (<element>_visible).
