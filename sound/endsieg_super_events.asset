}

### SOUNDEFFECT ###

soundeffect = {
    name = endsieg_se_compiegne_cue
    sounds = {
        sound = endsieg_se_compiegne_sound
    }
    max_audible = 1
    max_audible_behaviour = fail
    is3d = no
    volume = 0.9
}

