### CATEGORY ###
# Super-event cues. Each entry is a one-shot sting played by sound_effect when the
# panel opens (see common/scripted_effects/endsieg_super_events.txt).
# Files live in sound/endsieg_super_events/, sourced from the Library of Congress
# National Jukebox mirrors on archive.org; provenance in docs/super_events/audio_provenance.md.

category = {
    name = "Effects"
    soundeffects = {
        endsieg_se_compiegne_cue
        endsieg_se_central_powers_victory_cue
        endsieg_se_fall_of_france_cue
        endsieg_se_russian_revolution_cue
        endsieg_se_spanish_civil_war_cue
        endsieg_se_great_war_outbreak_cue
        endsieg_se_sino_japanese_war_cue
        endsieg_se_first_balkan_war_cue
        endsieg_se_second_balkan_war_cue
    }
}

### SOUND ###

sound = {
    name = "endsieg_se_compiegne_sound"
    file = "endsieg_super_events/compiegne.ogg"
}

sound = {
    name = "endsieg_se_central_powers_victory_sound"
    file = "endsieg_super_events/central_powers_victory.ogg"
